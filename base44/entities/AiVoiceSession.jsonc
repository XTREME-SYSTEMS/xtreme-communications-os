{
  "name": "AiVoiceSession",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "agent_config_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "streaming",
        "listening",
        "speaking",
        "interrupted",
        "summarized",
        "ended"
      ],
      "default": "streaming"
    },
    "stt_text": {
      "type": "string"
    },
    "tts_text": {
      "type": "string"
    },
    "tts_audio_url": {
      "type": "string"
    },
    "context_state": {
      "type": "object"
    },
    "interrupted": {
      "type": "boolean",
      "default": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_sec": {
      "type": "number"
    }
  },
  "required": [
    "tenant_id"
  ]
}