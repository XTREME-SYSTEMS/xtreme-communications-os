{
  "name": "CommsEvent",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "voice",
        "sms",
        "mms",
        "whatsapp",
        "rcs",
        "email",
        "video"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "from_addr": {
      "type": "string"
    },
    "to_addr": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "queued",
        "sent",
        "delivered",
        "completed",
        "ringing",
        "failed",
        "undelivered",
        "expired",
        "suppressed",
        "cancelled"
      ],
      "default": "active"
    },
    "provider_id": {
      "type": "string",
      "description": "ID of the provider that handled this event"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Provider's message/call ID for correlation"
    },
    "error_code": {
      "type": "string",
      "description": "Carrier or provider error code"
    },
    "error_detail": {
      "type": "string",
      "description": "Human-readable error description"
    },
    "duration_sec": {
      "type": "number"
    },
    "classification": {
      "type": "string",
      "enum": [
        "LIVE",
        "PROVIDER-BACKED",
        "SANDBOX",
        "MOCK/DEV-ONLY"
      ],
      "default": "MOCK/DEV-ONLY"
    },
    "summary": {
      "type": "string"
    },
    "recording_url": {
      "type": "string"
    },
    "recording_status": {
      "type": "string",
      "enum": [
        "none",
        "recording",
        "completed",
        "failed"
      ],
      "default": "none"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant ownership for multi-tenant isolation"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Idempotency key to prevent duplicate sends"
    },
    "campaign_id": {
      "type": "string",
      "description": "Campaign this event belongs to"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Cost of this communication event"
    }
  },
  "required": [
    "channel",
    "direction"
  ]
}