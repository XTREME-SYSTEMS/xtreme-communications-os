{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "key_value": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "key_value"
  ]
}