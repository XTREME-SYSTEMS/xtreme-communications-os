{
  "name": "SyncEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (UUID)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "message.received",
        "message.send.requested",
        "message.send.approved",
        "message.sent",
        "message.delivered",
        "message.failed",
        "agent.task.created",
        "agent.task.completed",
        "agent.escalated",
        "approval.requested"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Owner user ID for per-user isolation"
    },
    "correlation_id": {
      "type": "string",
      "description": "Groups related events in a conversation flow"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID of the event that caused this one"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Dedup key to prevent duplicate events"
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "provider",
        "human",
        "agent",
        "system"
      ],
      "default": "system"
    },
    "actor_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "comms_event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Linked CommsEvent record ID"
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Linked Conversation record ID"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "correlation_id",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}