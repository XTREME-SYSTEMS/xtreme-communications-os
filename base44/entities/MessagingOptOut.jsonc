{
  "name": "MessagingOptOut",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this suppression applies to"
    },
    "e164": {
      "type": "string",
      "description": "Suppressed number in E.164 format"
    },
    "number_key": {
      "type": "string",
      "description": "Digits-only key for exact matching"
    },
    "reason": {
      "type": "string",
      "description": "STOP reply, manual, complaint, wrong_number, etc."
    },
    "source": {
      "type": "string",
      "description": "How the opt-out was captured (reply, gateway, import)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "False once the contact re-consents"
    },
    "opted_out_at": {
      "type": "string",
      "format": "date-time"
    },
    "reinstated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "e164",
    "number_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}