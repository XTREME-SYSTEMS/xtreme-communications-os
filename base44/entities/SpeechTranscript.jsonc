{
  "name": "SpeechTranscript",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "voice_session_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ],
      "default": "user"
    },
    "content": {
      "type": "string"
    },
    "stt_confidence": {
      "type": "number"
    },
    "tts_audio_url": {
      "type": "string"
    },
    "interrupted": {
      "type": "boolean",
      "default": false
    },
    "turn_index": {
      "type": "integer",
      "default": 0
    },
    "sentiment": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative",
            "frustrated",
            "confused"
          ]
        },
        "score": {
          "type": "number"
        }
      }
    },
    "latency_ms": {
      "type": "number",
      "default": 0
    },
    "silence_gap_ms": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "voice_session_id"
  ]
}