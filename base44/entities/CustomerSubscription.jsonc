{
  "name": "CustomerSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 User ID of the customer"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email of the buyer (for anonymous purchases claimed on signup)"
    },
    "company_name": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "launch",
        "essential",
        "professional",
        "growth",
        "agency",
        "enterprise",
        "pay_as_you_go"
      ],
      "default": "pay_as_you_go"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "MONTH",
        "YEAR"
      ],
      "default": "MONTH"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled"
      ],
      "default": "trial"
    },
    "promo_code": {
      "type": "string",
      "description": "Promo code applied at signup"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_current_step": {
      "type": "integer",
      "default": 0,
      "description": "Index of the current onboarding step (0-based)"
    },
    "onboarding_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "onboarding_data": {
      "type": "object",
      "description": "All data collected during onboarding (company info, agent config, templates, etc.)"
    },
    "phone_numbers_count": {
      "type": "integer",
      "default": 0
    },
    "ai_agents_count": {
      "type": "integer",
      "default": 0
    },
    "monthly_spend": {
      "type": "number",
      "default": 0
    },
    "max_agents": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: max AI agents allowed"
    },
    "max_phone_numbers": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: max phone numbers allowed"
    },
    "monthly_sms_allowance": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: SMS messages included per month"
    },
    "monthly_ai_voice_minutes": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: AI voice minutes included per month"
    },
    "monthly_email_allowance": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: emails included per month"
    },
    "workflow_limit": {
      "type": "integer",
      "default": 0,
      "description": "Entitlement: max workflow slots"
    },
    "has_crm": {
      "type": "boolean",
      "default": false
    },
    "has_breeze_copilot": {
      "type": "boolean",
      "default": false
    },
    "has_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "has_call_recording": {
      "type": "boolean",
      "default": false
    },
    "has_lead_scraper": {
      "type": "boolean",
      "default": false
    },
    "has_api_access": {
      "type": "boolean",
      "default": false
    },
    "has_white_label": {
      "type": "boolean",
      "default": false
    },
    "has_multi_tenant": {
      "type": "boolean",
      "default": false
    },
    "has_sso": {
      "type": "boolean",
      "default": false
    },
    "sla_tier": {
      "type": "string",
      "default": "none"
    },
    "support_tier": {
      "type": "string",
      "default": "email"
    }
  },
  "required": [
    "user_id",
    "plan"
  ]
}