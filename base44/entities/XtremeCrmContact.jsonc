{
  "name": "XtremeCrmContact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "lead",
        "contacted",
        "qualified",
        "proposal",
        "won",
        "lost"
      ],
      "default": "lead"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "scraper",
        "manual",
        "import",
        "form",
        "referral"
      ],
      "default": "manual"
    },
    "enrichment_data": {
      "type": "object",
      "description": "Extra enriched data (social profiles, employee count, revenue, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "deal_value": {
      "type": "number",
      "default": 0
    },
    "owner_id": {
      "type": "string"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_contact_channel": {
      "type": "string",
      "enum": [
        "voice",
        "sms",
        "mms",
        "email",
        "whatsapp",
        "none"
      ],
      "default": "none"
    },
    "follow_up_enabled": {
      "type": "boolean",
      "default": false
    },
    "follow_up_frequency_days": {
      "type": "integer",
      "default": 3
    },
    "follow_up_method": {
      "type": "string",
      "enum": [
        "voice",
        "sms",
        "mms",
        "email",
        "whatsapp"
      ],
      "default": "sms"
    },
    "follow_up_template_id": {
      "type": "string"
    },
    "follow_up_automated": {
      "type": "boolean",
      "default": false
    },
    "next_follow_up_at": {
      "type": "string",
      "format": "date-time"
    },
    "follow_up_count": {
      "type": "integer",
      "default": 0
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "AgentPersona ID this contact is assigned to"
    },
    "follow_up_from_number": {
      "type": "string",
      "description": "Phone number the assigned agent sends from"
    },
    "hubspot_synced": {
      "type": "boolean",
      "default": false
    },
    "hubspot_contact_id": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ]
}