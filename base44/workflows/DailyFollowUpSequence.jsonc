{
  "name": "Daily Follow-Up Sequence",
  "description": "Sends the next day's message from the 15-day WhatsApp playbook to PCU alumni contacts due for follow-up. Runs daily at 9am ET.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_follow_up_sequence",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_follow_ups": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyFollowUpSequence",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send Daily Follow-Ups",
            "description": "15-day WhatsApp sequence to PCU alumni"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}