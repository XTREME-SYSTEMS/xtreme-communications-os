{
  "name": "OutboxMessage",
  "type": "object",
  "properties": {
    "outbox_id": {
      "type": "string",
      "description": "Unique outbox entry ID (UUID)"
    },
    "tenant_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user ID for per-user isolation"
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Conversation this reply belongs to"
    },
    "to_number": {
      "type": "string",
      "description": "Recipient phone number E.164"
    },
    "from_number": {
      "type": "string",
      "description": "Sender phone number E.164"
    },
    "body": {
      "type": "string",
      "description": "Message content"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "mms",
        "whatsapp"
      ],
      "default": "sms"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "sending",
        "sent",
        "delivered",
        "failed",
        "dead_letter"
      ],
      "default": "pending_approval"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Dedup key to prevent duplicate sends"
    },
    "approval_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": "string",
      "default": "twilio"
    },
    "provider_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retry_count": {
      "type": "integer",
      "default": 0
    },
    "max_retries": {
      "type": "integer",
      "default": 3
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_by": {
      "type": "string",
      "description": "Actor ID that requested the send"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Actor ID that approved the send"
    },
    "is_draft": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a draft (not yet requested for approval)"
    },
    "queued_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "delivered_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    }
  },
  "required": [
    "outbox_id",
    "tenant_id",
    "to_number",
    "body",
    "idempotency_key",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}