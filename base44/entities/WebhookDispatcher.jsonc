{
  "name": "WebhookDispatcher",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "secret_hash": {
      "type": "string"
    },
    "signing_secret": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "failing"
      ],
      "default": "active"
    },
    "last_delivery_status": {
      "type": "string"
    },
    "failure_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "url"
  ]
}