{
  "name": "CampaignContact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source": {
      "type": "string",
      "description": "Where this contact came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "responded",
        "interested",
        "converted",
        "unsubscribed",
        "bounced"
      ],
      "default": "new"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_contact_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "mms",
        "voice",
        "none"
      ],
      "default": "none"
    },
    "follow_up_stage": {
      "type": "integer",
      "default": 0,
      "description": "0=no contact, 1=first touch, 2=follow-up 1, 3=follow-up 2, etc."
    },
    "next_follow_up_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "replica_id": {
      "type": "string",
      "description": "UserReplica ID this contact belongs to"
    }
  },
  "required": [
    "full_name"
  ]
}