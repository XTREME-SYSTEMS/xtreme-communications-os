{
  "name": "BillingAccount",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "growth",
        "enterprise"
      ],
      "default": "starter"
    },
    "balance_cents": {
      "type": "integer",
      "default": 0
    },
    "credit_cents": {
      "type": "integer",
      "default": 0
    },
    "billing_cycle_start": {
      "type": "string",
      "format": "date"
    },
    "billing_cycle_end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "closed"
      ],
      "default": "active"
    },
    "auto_recharge": {
      "type": "boolean",
      "default": false
    },
    "usage_this_cycle_cents": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "tenant_id"
  ]
}