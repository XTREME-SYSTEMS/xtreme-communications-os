{
  "name": "AgentPersona",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "persona_type": {
      "type": "string",
      "enum": [
        "voice",
        "email",
        "phone",
        "social_media"
      ],
      "default": "voice"
    },
    "voice_id": {
      "type": "string",
      "description": "Telnyx Ultra voice UUID for voice personas"
    },
    "system_prompt": {
      "type": "string"
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tone": {
      "type": "string"
    },
    "assigned_context": {
      "type": "string",
      "description": "Situation or job this persona is assigned to (e.g. sales calls, support emails)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "avatar_color": {
      "type": "string",
      "default": "#ff6b00"
    },
    "playbook_id": {
      "type": "string",
      "description": "Which playbook from the library this agent runs"
    },
    "assigned_number": {
      "type": "string",
      "description": "Phone number this agent sends from"
    },
    "target_industry": {
      "type": "string",
      "description": "Industry this agent targets"
    },
    "target_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contact tags this agent targets"
    },
    "provisioned_at": {
      "type": "string",
      "format": "date-time"
    },
    "contacts_assigned": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "name",
    "persona_type"
  ]
}