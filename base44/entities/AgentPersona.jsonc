{
  "name": "AgentPersona",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "persona_type": {
      "type": "string",
      "enum": [
        "voice",
        "email",
        "phone",
        "social_media",
        "super",
        "swarm_coordinator",
        "swarm_worker",
        "fulfillment",
        "shadow"
      ],
      "default": "voice"
    },
    "agent_tier": {
      "type": "string",
      "enum": [
        "standard",
        "super",
        "swarm",
        "fulfillment",
        "shadow"
      ],
      "default": "standard",
      "description": "Power tier of the agent"
    },
    "voice_id": {
      "type": "string",
      "description": "Telnyx Ultra voice UUID for voice personas"
    },
    "system_prompt": {
      "type": "string"
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tone": {
      "type": "string"
    },
    "assigned_context": {
      "type": "string",
      "description": "Situation or job this persona is assigned to (e.g. sales calls, support emails)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "avatar_color": {
      "type": "string",
      "default": "#ff6b00"
    },
    "playbook_id": {
      "type": "string",
      "description": "Which playbook from the library this agent runs"
    },
    "assigned_number": {
      "type": "string",
      "description": "Phone number this agent sends from"
    },
    "target_industry": {
      "type": "string",
      "description": "Industry this agent targets"
    },
    "target_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Contact tags this agent targets"
    },
    "provisioned_at": {
      "type": "string",
      "format": "date-time"
    },
    "contacts_assigned": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "draft"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sms",
          "mms",
          "voice",
          "whatsapp",
          "email",
          "cloud_browser",
          "phone_browser",
          "web_interact",
          "api_access",
          "cross_site_automation",
          "shadow_mode",
          "social_media"
        ]
      },
      "default": [
        "sms"
      ],
      "description": "Communication and automation capabilities enabled for this agent"
    },
    "swarm_id": {
      "type": "string",
      "description": "Shared ID grouping swarm agents together"
    },
    "swarm_role": {
      "type": "string",
      "enum": [
        "coordinator",
        "worker"
      ],
      "default": "worker"
    },
    "swarm_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Agent IDs of swarm workers (coordinator only)"
    },
    "swarm_coordinator_id": {
      "type": "string",
      "description": "ID of the coordinator agent (workers only)"
    },
    "shadow_mode": {
      "type": "boolean",
      "default": false,
      "description": "Stealth mode \u2014 agent operates autonomously without direct supervision"
    },
    "fulfillment_config": {
      "type": "object",
      "properties": {
        "auto_execute": {
          "type": "boolean",
          "default": true
        },
        "retry_count": {
          "type": "integer",
          "default": 3
        },
        "timeout_seconds": {
          "type": "integer",
          "default": 120
        },
        "browser_type": {
          "type": "string",
          "enum": [
            "cloud",
            "phone",
            "both"
          ],
          "default": "cloud"
        }
      },
      "default": {}
    },
    "api_credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "api_key": {
            "type": "string"
          },
          "auth_type": {
            "type": "string",
            "enum": [
              "basic",
              "bearer",
              "api_key",
              "session"
            ],
            "default": "basic"
          }
        }
      },
      "default": [],
      "description": "Credentials for cross-site automation \u2014 usernames, passwords, API keys for other apps"
    },
    "api_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "url": {
            "type": "string"
          },
          "headers": {
            "type": "object"
          },
          "body_template": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Custom API endpoints this agent can call"
    },
    "power_level": {
      "type": "integer",
      "default": 1,
      "description": "1-10 power level for super agents"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "manual",
        "supervised",
        "autonomous",
        "fully_autonomous"
      ],
      "default": "supervised"
    }
  },
  "required": [
    "name",
    "persona_type"
  ]
}